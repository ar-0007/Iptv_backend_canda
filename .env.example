# Copy to .env (local) or set these in Render -> Environment.

# ---------- required ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs every dashboard session. MUST be >= 32 random characters and MUST be kept secret —
# anyone holding it can mint a token for any account. The server refuses to start without it.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Browser origins allowed to call the admin API (comma-separated). REQUIRED in production.
ALLOWED_ORIGINS=https://your-dashboard.netlify.app

# ---------- first run only ----------
# Seeds the FIRST admin account when the resellers table is empty. After that, accounts live in
# the database and these two are ignored — remove them once the admin exists.
ADMIN_EMAIL=admin@10kultra.tv
ADMIN_PASSWORD=

# ---------- product isolation — DO NOT LEAVE THESE UNSET ----------
# 10K Ultra's own tables (see dashboard/supabase/schema-10kultra.sql). These are NOT optional:
# unset, the server falls back to the shared `devices` / `app_versions` tables, which puts another
# product's boxes in this dashboard and pushes that product's releases to 10K Ultra as a forced
# "Update Required".
DEVICES_TABLE=tenkultra_devices
VERSIONS_TABLE=tenkultra_app_versions
RESELLERS_TABLE=tenkultra_resellers

# Serve OTA updates from VERSIONS_TABLE. Safe to leave on: with no published row the API simply
# answers "no update". Only set false if you want to freeze every box on its installed build.
OTA_ENABLED=true

# ---------- optional ----------
NODE_ENV=production
SESSION_HOURS=12
DASHBOARD_URL=https://your-dashboard.netlify.app
DEFAULT_PORTAL_URL=http://tv.a1tv.ac
# PORT is provided by Render automatically; defaults to 4000 locally.
